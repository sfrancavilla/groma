# Lock the session before the machine sleeps.
#
# Closing the lid suspends (logind's HandleLidSwitch=suspend) and the idle
# chain cannot help, because suspending stops the clock - without this, closing
# the lid and reopening it lands straight on an unlocked desktop.
#
# A system unit rather than a user one: systemd still has no sleep.target in
# the user manager, so there is nothing there to hook.
#
# It names no user, uid or display: groma-lock-sessions finds every running
# Groma by its process. install.sh copies both files into place, owned by root
# - a unit that runs as root must not be a file the user can edit.

[Unit]
Description=Lock every Groma session before sleep
Before=sleep.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/groma/groma-lock-sessions lock

[Install]
WantedBy=sleep.target
